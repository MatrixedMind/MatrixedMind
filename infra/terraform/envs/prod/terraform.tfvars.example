project_id        = "your-production-project-id"
github_repository = "your-github-owner/your-github-repo"

# Apply the production foundation first. Enable only after an immutable image and both numbered
# secret versions exist.
enable_cloud_run_service = false
container_image          = ""
app_secret_key_version   = "1"
llm_token_pepper_version = "1"

# Empty allows any safe external HTTPS image host. Use exact hosts or *.domain wildcards to limit it.
markdown_image_source_allowlist = ""

# Public source offered from the hosted interface. The image build embeds the exact Git commit.
source_repository_url = "https://github.com/MatrixedMind/MatrixedMind"
llm_api_server_url    = "https://matrixedmind.com"

# Stage privately first. Change to external_load_balancer only after application-level protection,
# the Invoker IAM-check policy, and the separate edge attachment are approved.
cloud_run_invocation_mode = "private"

# Required for cross-project attachment after the edge administrator identity is selected. Use an
# explicit managed-domain user, group, or service account; never use allUsers here.
edge_load_balancer_service_user_members = []
load_balancer_backend_service_name      = null

# Optional defense in depth. Keep null until Cloud Armor Enterprise cost, the published range feed,
# and its refresh procedure have been reviewed. Scoped bearer tokens remain mandatory.
openai_action_address_group_name = null

# Operational email is an apply-time input: use TF_VAR_operational_notification_email or an
# ignored tfvars file. It creates the conventional MatrixedMind production channel when either
# alerting or the budget is enabled. The recipient is retained in Terraform state.
operational_notification_email              = null
external_operational_notification_channels  = [] # Optional full resource names to reuse.
external_budget_notification_channels       = [] # Optional verified email-channel resource names.

# Disabled until the single audited cloud-mutation plan is approved. Do not commit the recipient,
# billing account, or spending limit. Tune alert thresholds only from deployed metrics.
enable_billing_budget                    = false
billing_account_id                       = ""
billing_budget_amount_units              = null
enable_operational_alerting              = false
cloud_run_error_rate_threshold           = 0.05
cloud_run_latency_threshold_milliseconds = 10000
