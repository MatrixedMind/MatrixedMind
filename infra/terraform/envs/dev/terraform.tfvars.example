project_id        = "your-gcp-project-id"
github_repository = "your-github-owner/your-github-repo"

# Enable after an application image has been pushed.
enable_cloud_run_service = false
container_image          = ""

# Cloud Run references explicit versions; create these versions before enabling the service.
app_secret_key_version    = "1"
llm_token_pepper_version  = "1"

# Empty allows any safe external HTTPS image host. Use exact hosts or *.domain wildcards to limit it.
markdown_image_source_allowlist = ""

# Public source offered from the hosted interface. The image build embeds the exact Git commit.
source_repository_url = "https://github.com/MatrixedMind/MatrixedMind"

# Enable after the dedicated test image has been pushed to Artifact Registry.
enable_firestore_spike_job = false
firestore_spike_image      = ""

# The development root always keeps Cloud Run private. Public invocation modes belong to a
# self-hosted composition or the separate production root.

# Optional billing budget.
billing_account_id          = ""
billing_budget_amount_units = null
