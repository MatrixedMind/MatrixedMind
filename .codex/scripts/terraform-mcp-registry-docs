#!/bin/sh
# Execute only a user-installed Terraform MCP binary proven to match the
# checked-in, public HashiCorp release archive. This script never downloads or
# installs artifacts.
set -eu
PATH='/usr/bin:/bin:/usr/sbin:/sbin'
export PATH

readonly expected_args='stdio --tools=search_providers,get_provider_details'
if [ "$*" != "$expected_args" ]; then
  echo "Terraform MCP wrapper rejects arguments outside the Registry documentation allowlist." >&2
  exit 64
fi

if [ "$(/usr/bin/uname -s)" != "Darwin" ] || [ "$(/usr/bin/uname -m)" != "arm64" ]; then
  echo "Terraform MCP wrapper has no approved manifest for this platform." >&2
  exit 65
fi

script_dir=$(CDPATH= cd -- "$(/usr/bin/dirname "$0")" && pwd -P)
codex_dir=$(/usr/bin/dirname "$script_dir")
repo_dir=$(/usr/bin/dirname "$codex_dir")
manifest="$codex_dir/terraform-mcp-registry-docs.manifest.toml"
expected_archive='terraform-mcp-server_1.1.0_darwin_arm64.zip'
expected_sha256='741e7175224a54fcef1c132c272a3fbf9362f4fc00469ae2c370b8c2ae8f3ef8'
expected_source='https://releases.hashicorp.com/terraform-mcp-server/1.1.0/terraform-mcp-server_1.1.0_darwin_arm64.zip'

if [ ! -r "$manifest" ]; then
  echo "Terraform MCP wrapper manifest is unavailable." >&2
  exit 66
fi
manifest_version=$(/usr/bin/awk -F ' = ' '$1 == "version" { gsub(/"/, "", $2); print $2 }' "$manifest")
manifest_platform=$(/usr/bin/awk -F ' = ' '$1 == "platform" { gsub(/"/, "", $2); print $2 }' "$manifest")
manifest_archive=$(/usr/bin/awk -F ' = ' '$1 == "archive" { gsub(/"/, "", $2); print $2 }' "$manifest")
manifest_sha256=$(/usr/bin/awk -F ' = ' '$1 == "sha256" { gsub(/"/, "", $2); print $2 }' "$manifest")
manifest_source=$(/usr/bin/awk -F ' = ' '$1 == "source" { gsub(/"/, "", $2); print $2 }' "$manifest")
if [ "$manifest_version" != '1.1.0' ] || [ "$manifest_platform" != 'darwin_arm64' ] || [ "$manifest_archive" != "$expected_archive" ] || [ "$manifest_sha256" != "$expected_sha256" ] || [ "$manifest_source" != "$expected_source" ]; then
  echo "Terraform MCP wrapper manifest does not match the approved release metadata." >&2
  exit 77
fi

archive=${MATRIXEDMIND_TERRAFORM_MCP_ARCHIVE:-}
binary=${MATRIXEDMIND_TERRAFORM_MCP_BINARY:-}
if [ -z "$archive" ] || [ -z "$binary" ]; then
  echo "Set MATRIXEDMIND_TERRAFORM_MCP_ARCHIVE and MATRIXEDMIND_TERRAFORM_MCP_BINARY to verified external paths." >&2
  exit 67
fi
if [ ! -f "$archive" ] || [ "$(/usr/bin/basename "$archive")" != "$expected_archive" ]; then
  echo "Terraform MCP archive is missing or does not match the approved artifact name." >&2
  exit 68
fi
if [ ! -x "$binary" ]; then
  echo "Terraform MCP binary is missing or not executable." >&2
  exit 69
fi

archive_dir=$(CDPATH= cd -- "$(/usr/bin/dirname "$archive")" && pwd -P)
binary_dir=$(CDPATH= cd -- "$(/usr/bin/dirname "$binary")" && pwd -P)
case "$archive_dir" in "$repo_dir"/*) echo "Terraform MCP archive must remain outside the repository." >&2; exit 70;; esac
case "$binary_dir" in "$repo_dir"/*) echo "Terraform MCP binary must remain outside the repository." >&2; exit 71;; esac

temp_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/matrixedmind-terraform-mcp.XXXXXX")
cleanup() { /bin/rm -rf "$temp_dir"; }
trap cleanup EXIT HUP INT TERM
private_archive="$temp_dir/$expected_archive"
/bin/cp "$archive" "$private_archive"
actual_archive_sha256=$(/usr/bin/shasum -a 256 "$private_archive" | /usr/bin/awk '{print $1}')
if [ "$actual_archive_sha256" != "$expected_sha256" ]; then
  echo "Terraform MCP archive checksum does not match the approved manifest." >&2
  exit 72
fi

/usr/bin/unzip -qq "$private_archive" -d "$temp_dir"
reference_binary="$temp_dir/terraform-mcp-server"
if [ ! -f "$reference_binary" ]; then
  echo "Approved Terraform MCP archive does not contain the expected binary." >&2
  exit 73
fi
verified_binary="$temp_dir/verified-terraform-mcp-server"
/bin/cp "$reference_binary" "$verified_binary"
/bin/chmod 700 "$verified_binary"
reference_sha256=$(/usr/bin/shasum -a 256 "$verified_binary" | /usr/bin/awk '{print $1}')
actual_binary_sha256=$(/usr/bin/shasum -a 256 "$binary" | /usr/bin/awk '{print $1}')
if [ "$actual_binary_sha256" != "$reference_sha256" ]; then
  echo "Terraform MCP binary does not match the approved archive." >&2
  exit 74
fi
version_output=$(/usr/bin/env -i PATH='/usr/bin:/bin:/usr/sbin:/sbin' "$verified_binary" --version 2>&1) || {
  echo "Terraform MCP binary version check failed." >&2
  exit 75
}
case "$version_output" in *1.1.0*) ;; *) echo "Terraform MCP binary is not v1.1.0." >&2; exit 76;; esac

# Remove inherited credentials (including HCP/TFE and private-registry tokens).
# Do not exec: the EXIT trap must remove the verified temporary copy.
set +e
/usr/bin/env -i PATH='/usr/bin:/bin:/usr/sbin:/sbin' "$verified_binary" "$@"
status=$?
set -e
exit "$status"
